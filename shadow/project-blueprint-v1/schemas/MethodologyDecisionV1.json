{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multiplan:shadow:MethodologyDecisionV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "METHODOLOGY_DECISION_V1"
    },
    "methodology_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "recommended_id": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "abp",
            "steam",
            "aprendizaje_servicio",
            "proyectos_comunitarios"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_id": {
      "type": "string",
      "enum": [
        "abp",
        "steam",
        "aprendizaje_servicio",
        "proyectos_comunitarios"
      ]
    },
    "selection_source": {
      "type": "string",
      "enum": [
        "TEACHER",
        "TEACHER_ACCEPTED_RECOMMENDATION"
      ]
    },
    "catalog_version": {
      "const": "METHODOLOGY_CATALOG_V1"
    },
    "required_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "methodology_decision_id",
    "recommended_id",
    "selected_id",
    "selection_source",
    "catalog_version",
    "required_operations"
  ],
  "additionalProperties": false
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:multiplan:shadow:SessionGraphV1",
  "type":"object",
  "required":["schema_version","graph_id","revision","status","source_blueprint","sessions","traceability","gate_result"],
  "additionalProperties":false,
  "properties":{
    "schema_version":{"const":"SESSION_GRAPH_V1"},
    "graph_id":{"type":"string","minLength":1},
    "revision":{"type":"integer","minimum":1},
    "status":{"enum":["DRAFT","NEEDS_REPAIR","APPROVED","REJECTED"]},
    "source_blueprint":{"type":"object","additionalProperties":false,"required":["blueprint_id","blueprint_revision","blueprint_hash","approved_blueprint_hash","gate_version"],"properties":{"blueprint_id":{"type":"string","minLength":1},"blueprint_revision":{"type":"integer","minimum":1},"blueprint_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"approved_blueprint_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"gate_version":{"const":"BLUEPRINT_GATE_V1"}}},
    "sessions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/session"}},
    "traceability":{"type":"object","additionalProperties":false,"required":["pda","methodology","artifacts","functional_requirements"],"properties":{"pda":{"type":"object"},"methodology":{"type":"object"},"artifacts":{"type":"object"},"functional_requirements":{"type":"object"}}},
    "gate_result":{"type":["object","null"]}
  },
  "$defs":{
    "session":{"type":"object","additionalProperties":false,"required":["session_id","session_number","stage_ids","project_state_before","session_project_goal","required_learning","pda_focus","methodology_operations","input_artifact_ids","expected_output_artifact_ids","expected_partial_product","blueprint_acceptance_criteria","project_state_after","terminal","next_session_dependency","activities"],"properties":{"session_id":{"type":"string"},"session_number":{"type":"integer","minimum":1},"stage_ids":{"type":"array","items":{"type":"string"}},"project_state_before":{"type":"string"},"session_project_goal":{"type":"string"},"required_learning":{"type":"array","items":{"type":"string"}},"pda_focus":{"type":"array","items":{"type":"string"}},"methodology_operations":{"type":"array","items":{"type":"string"}},"input_artifact_ids":{"type":"array","items":{"type":"string"}},"expected_output_artifact_ids":{"type":"array","items":{"type":"string"}},"expected_partial_product":{"type":"string"},"blueprint_acceptance_criteria":{"type":"array","items":{"type":"string"}},"project_state_after":{"type":"string"},"terminal":{"type":"boolean"},"next_session_dependency":{"type":["integer","null"]},"ltg_decisions":{"type":"array","items":{"$ref":"#/$defs/ltgDecision"}},"activities":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/activity"}}}},
    "activity":{"type":"object","additionalProperties":false,"required":["activity_id","order","title","contribution_mode","contribution_rationale","common_student_action","grade_participation","teacher_role","resources","supports","minutes","input_refs","output","output_ref","contributes_to_artifact_ids","methodology_operations","functional_requirement_ids","ltg_activity_ids","evidence","assessment_criteria"],"properties":{"execution":{"$ref":"#/$defs/execution"},"ltg_use":{"type":"array","items":{"$ref":"#/$defs/ltgUse"}},"activity_id":{"type":"string"},"order":{"type":"integer","minimum":1},"title":{"type":"string"},"contribution_mode":{"enum":["DIRECT","COMPLEMENTARY"]},"contribution_rationale":{"type":"string"},"common_student_action":{"type":"string"},"grade_participation":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gradeParticipation"}},"teacher_role":{"type":"string"},"resources":{"type":"array","items":{"type":"string"}},"supports":{"type":"array","items":{"type":"string"}},"minutes":{"type":"integer","minimum":1},"input_refs":{"type":"array","items":{"type":"string"}},"output":{"type":"string"},"output_ref":{"type":"string"},"contributes_to_artifact_ids":{"type":"array","items":{"type":"string"}},"methodology_operations":{"type":"array","items":{"type":"string"}},"functional_requirement_ids":{"type":"array","items":{"type":"string"}},"ltg_activity_ids":{"type":"array","items":{"type":"string"}},"evidence":{"type":"string"},"assessment_criteria":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "execution":{"type":"object","additionalProperties":false,"required":["preparation","instruction","student_steps","grouping","guidance","resource_use","contingency","connection"],"properties":{"preparation":{"type":"string","minLength":1},"instruction":{"type":"string","minLength":1},"grouping":{"type":"string","minLength":1},"contingency":{"type":"string","minLength":1},"connection":{"type":"string","minLength":1},"student_steps":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"guidance":{"type":"array","items":{"type":"string","minLength":1}},"resource_use":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["resource","use"],"properties":{"resource":{"type":"string","minLength":1},"use":{"type":"string","minLength":1}}}}}},
    "ltgUse":{"type":"object","additionalProperties":false,"required":["project_id","activity_id","student_action","moment","purpose","reference"],"properties":{"project_id":{"type":"string","minLength":1},"activity_id":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"student_action":{"type":"string","minLength":1},"moment":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"reference":{"type":"object","additionalProperties":false,"required":["book","project","grade","pages","verified_activity"],"properties":{"book":{"type":"string","minLength":1},"project":{"type":"string","minLength":1},"grade":{"type":"integer","minimum":1,"maximum":6},"pages":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"integer","minimum":1},"end":{"type":"integer","minimum":1}}},"verified_activity":{"anyOf":[{"type":"object","additionalProperties":false,"required":["activity_id","activity_order","summary","page_start","page_end","verification_status"],"properties":{"activity_id":{"type":"string","minLength":1},"activity_order":{"type":"integer","minimum":1},"summary":{"type":"string","minLength":1},"page_start":{"type":"integer","minimum":1},"page_end":{"type":"integer","minimum":1},"verification_status":{"const":"verified"}}},{"type":"null"}]}}}}},
    "ltgDecision":{"type":"object","additionalProperties":false,"required":["project_id","decision","reason"],"properties":{"project_id":{"type":"string","minLength":1},"decision":{"enum":["USE","NOT_RECOMMENDED"]},"reason":{"type":"string","minLength":1}}},
    "gradeParticipation":{"type":"object","additionalProperties":false,"required":["grade","student_action","differentiation","pda_mobilization","evidence"],"properties":{"grade":{"type":"integer","minimum":1,"maximum":6},"student_action":{"type":"string"},"differentiation":{"type":"string"},"pda_mobilization":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["pda_id","status"],"properties":{"pda_id":{"type":"string"},"status":{"enum":["WORKED","DEVELOPING"]}}}},"evidence":{"type":"string"}}}
  }
}
